<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Version>1.5.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.31" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlcipher" Version="3.0.5" />
  </ItemGroup>
  <!-- Supply SQLCipher Community native binaries for the target RID.
       The directory must include sqlcipher.dll or libsqlcipher.so and dependencies. -->
  <ItemGroup Condition="'$(SqlCipherNativeDirectory)' != ''">
    <Content Include="$(SqlCipherNativeDirectory)/*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
